# Port yang dipakai Express di dalam container.
PORT=5000

# MongoDB Atlas connection string.
# Ganti <user>, <password>, dan <cluster> dengan milik kamu sendiri.
# Nama database ditulis setelah tanda "/" — di sini bion-tk-marketplace.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bion-tk-marketplace?appName=Cluster0

# Kunci untuk menandatangani JWT (token login). Isi string acak yang panjang.
JWT_SECRET=ganti-dengan-string-acak-yang-panjang

# Alamat publik backend, dipakai seed.js untuk menyusun URL gambar produk.
# Kosongkan saat development — otomatis jadi http://localhost:<PORT>.
# Isi hanya kalau backend diakses dari alamat lain, tanpa garis miring di akhir.
# ASSET_BASE_URL=https://api.contoh.com
